<script>
function impersonateGo() {
    const sel = document.getElementById('impersonateSelect');
    const id = sel.value;
    if (!id) { alert('Выбери пользователя'); return; }
    window.location.href = 'impersonate.php?action=start&user_id=' + encodeURIComponent(id);
}
</script>

<main class="max-w-7xl mx-auto px-4 py-6">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-100 dark:bg-slate-900 text-left">
                <tr>
                    <th class="px-4 py-2">ID</th>
                    <th class="px-4 py-2">Имя</th>
                    <th class="px-4 py-2">Email</th>
                    <th class="px-4 py-2">Группа</th>
                    <th class="px-4 py-2">Роль</th>
                    <th class="px-4 py-2">Статус</th>
                    <th class="px-4 py-2">Действия</th>
                </tr>
            </thead>
            <tbody id="usersTable"></tbody>
        </table>
    </div>
</main>

<script>
let USERS = [];

async function loadUsers() {
    const res = await fetch('api.php?action=admin_users');
    const json = await res.json();
    USERS = json.data || [];
    renderUsers();
}

function renderUsers() {
    const tbody = document.getElementById('usersTable');
    tbody.innerHTML = USERS.map(u => `
        <tr class="border-t border-slate-200 dark:border-slate-700">
            <td class="px-4 py-2">${u.id}</td>
            <td class="px-4 py-2">${escapeHtml(u.name)}</td>
            <td class="px-4 py-2">${escapeHtml(u.email)}</td>
            <td class="px-4 py-2">${escapeHtml(u.group_name || '—')}</td>
            <td class="px-4 py-2">
                <select onchange="setRole(${u.id}, this.value)" class="px-2 py-1 border border-slate-300 dark:border-slate-600 rounded bg-white dark:bg-slate-900">
                    <option value="student" ${u.role==='student'?'selected':''}>Студент</option>
                    <option value="teacher" ${u.role==='teacher'?'selected':''}>Преподаватель</option>
                    <option value="admin"   ${u.role==='admin'?'selected':''}>Админ</option>
                </select>
            </td>
            <td class="px-4 py-2">
                ${u.blocked == 1 ? '<span class="text-red-500 font-medium">🚫 Заблокирован</span>' : '<span class="text-emerald-500">✅ Активен</span>'}
            </td>
            <td class="px-4 py-2">
                <button onclick="toggleBlock(${u.id}, ${u.blocked == 1 ? 0 : 1})"
                        class="px-2 py-1 rounded text-xs ${u.blocked == 1 ? 'bg-emerald-500 text-white' : 'bg-red-500 text-white'}">
                    ${u.blocked == 1 ? 'Разблокировать' : 'Заблокировать'}
                </button>
            </td>
        </tr>
    `).join('');
}

async function setRole(id, role) {
    const res = await fetch('api.php?action=admin_set_role', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, role })
    });
    if (!res.ok) { const j = await res.json(); alert(j.error || 'Ошибка'); await loadUsers(); }
}

async function toggleBlock(id, blocked) {
    const res = await fetch('api.php?action=admin_block', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, blocked })
    });
    if (res.ok) await loadUsers();
    else { const j = await res.json(); alert(j.error || 'Ошибка'); }
}

function escapeHtml(s) {
    const div = document.createElement('div');
    div.textContent = s == null ? '' : String(s);
    return div.innerHTML;
}

loadUsers();
</script>
</body>
</html>
